---
import pages from '../data/pages.json';
import { rewrite, stripEagerRecaptcha, stripDeadScripts } from '../lib/site.js';
import { skipLink } from '../lib/chrome.js';
import { cssFixes } from '../lib/fixes.js';
import { modernCss } from '../lib/modern.js';
import { refreshPriceValidUntil } from '../lib/pricing.js';
import { breadcrumbSchema } from '../lib/breadcrumbs.js';
import { deferChat } from '../lib/defer-chat.js';
import { heroPicture, heroPreload } from '../lib/hero-image.js';
import { configuratorCta, configuratorCtaCss } from '../lib/configurator-cta.js';
import { embedConfigurator, embedCss, isProduct } from '../lib/product-configurator.js';
import { configuratorCss } from '../lib/configurator.js';
import { categoryCss } from '../lib/category-css.js';
import { enhanceCategory } from '../lib/category-render.js';
import { enhanceProduct } from '../lib/product-render.js';
import { faqSchema } from '../lib/faq-schema.js';
import { rebuildArchive, archiveResultCount, brandByline, resourcesCss } from '../lib/resources.js';
import Header from '../components/Header.astro';
import Offcanvas from '../components/Offcanvas.astro';
import Footer from '../components/Footer.astro';
import JoinChat from '../components/JoinChat.astro';

export function getStaticPaths() {
  return Object.values(pages).map((page) => ({
    // Astro's rest param wants the path without the leading/trailing slash;
    // trailingSlash: 'always' + build.format 'directory' restore them.
    params: { path: page.route === '/' ? undefined : page.route.slice(1, -1) },
    props: { page },
  }));
}

const { page } = Astro.props;
// the FAQ schema must describe what the page finally renders, so the content
// transforms run once here and the result feeds both the head and the body
let content = enhanceProduct({ ...page, content: enhanceCategory(page) });
// the guides archive is rebuilt from the post sitemap: the captured markup
// listed six of the eight published posts
content = archiveResultCount(rebuildArchive({ ...page, content }), page.route);
// the home page hero is the LCP element; give it renditions and a preload
const isHome = page.route === '/';
if (isHome) content = heroPicture(content);
// product pages carry the configurator itself, after the description; every
// other page gets the bar that links to it
const onProduct = isProduct(page.route);
content = onProduct ? embedConfigurator(content, page.route)
                    : configuratorCta(content, page.route);
// the theme printed the owner's personal Gmail address as the author byline
content = brandByline(content);
---
<!DOCTYPE html>
<html lang="en-US">
<head>
<Fragment set:html={deferChat(refreshPriceValidUntil(rewrite(page.head)))} />
<Fragment set:html={breadcrumbSchema(page)} />
<Fragment set:html={faqSchema(page.route, content)} />
{isHome && <Fragment set:html={heroPreload} />}
<Fragment set:html={cssFixes} />
<Fragment set:html={modernCss} />
<Fragment set:html={categoryCss} />
<Fragment set:html={configuratorCtaCss} />
<Fragment set:html={resourcesCss ? `<style>${resourcesCss}</style>` : ''} />
{onProduct && <Fragment set:html={configuratorCss + embedCss} />}
</head>

<body class={page.bodyClass}>
<Fragment set:html={page.bodyOpen} />

		<div id="main-container" class="site">
			<Fragment set:html={skipLink} />
				<Header page={page} />
				<Offcanvas page={page} />
				<Fragment set:html={rewrite(content)} />
				<Footer page={page} />
				</div><!-- #page -->
<Fragment set:html={stripDeadScripts(stripEagerRecaptcha(rewrite(page.bodyTail)), content)} />
{page.popup && <Fragment set:html={rewrite(page.popup)} />}
<JoinChat page={page} />
<script src="/assets/ttp.js" data-elementor-frontend={page.elementorFrontend ? "1" : "0"} defer></script>
<script src="/assets/cart.js" defer></script>
{onProduct && <script is:inline src="/assets/configurator.js" defer></script>}
</body>
</html>
