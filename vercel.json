{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.thetubepackaging.com"
        }
      ],
      "destination": "https://thetubepackaging.com/$1",
      "permanent": true
    },
    {
      "source": "/shop/page/1",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/shop/page/1/",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/product-category/custom-paper-tubes/page/1",
      "destination": "/product-category/custom-paper-tubes/",
      "permanent": true
    },
    {
      "source": "/product-category/custom-paper-tubes/page/1/",
      "destination": "/product-category/custom-paper-tubes/",
      "permanent": true
    },
    {
      "source": "/category/uncategorized",
      "destination": "/category/information/",
      "permanent": true
    },
    {
      "source": "/category/uncategorized/",
      "destination": "/category/information/",
      "permanent": true
    },
    {
      "source": "/tube-configurator",
      "destination": "/design-your-tube-packaging/",
      "permanent": true
    },
    {
      "source": "/tube-configurator/",
      "destination": "/design-your-tube-packaging/",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/page-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/post-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/product-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/category-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/product_cat-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/author-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product-category/Custom-Cardboard-Tubes/",
      "destination": "/product-category/custom-cardboard-tubes/index.html"
    },
    {
      "source": "/product-category/Custom-Paper-Tubes/",
      "destination": "/product-category/custom-paper-tubes/index.html"
    },
    {
      "source": "/product-category/Custom-Paper-Tubes/page/2/",
      "destination": "/product-category/custom-paper-tubes/page/2/index.html"
    },
    {
      "source": "/product-category/Custom-Plastic-Tubes/",
      "destination": "/product-category/custom-plastic-tubes/index.html"
    }
  ]
}
