{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/shop/page/1",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/shop/page/1/",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/product-category/custom-paper-tubes/page/1",
      "destination": "/product-category/custom-paper-tubes/",
      "permanent": true
    },
    {
      "source": "/product-category/custom-paper-tubes/page/1/",
      "destination": "/product-category/custom-paper-tubes/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "//": "Staging only. The condition matches the *.vercel.app hostnames, so the header disappears by itself the moment the real domain is attached -- thetubepackaging.com never receives it.",
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product-category/Custom-Cardboard-Tubes/",
      "destination": "/product-category/custom-cardboard-tubes/index.html"
    },
    {
      "source": "/product-category/Custom-Paper-Tubes/",
      "destination": "/product-category/custom-paper-tubes/index.html"
    },
    {
      "source": "/product-category/Custom-Plastic-Tubes/",
      "destination": "/product-category/custom-plastic-tubes/index.html"
    }
  ]
}