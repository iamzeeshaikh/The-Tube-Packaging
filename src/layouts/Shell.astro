---
// The site chrome, driven by a captured page record. `[...path].astro` renders
// the migrated pages with it; the cart-flow pages that WordPress never served
// as HTML (checkout, order received) borrow the cart page's record so they
// inherit the same head, body classes, header, footer and scripts.
import { rewrite, stripEagerRecaptcha, stripDeadScripts } from '../lib/site.js';
import { skipLink } from '../lib/chrome.js';
import { cssFixes } from '../lib/fixes.js';
import { modernCss } from '../lib/modern.js';
import { refreshPriceValidUntil } from '../lib/pricing.js';
import { breadcrumbSchema } from '../lib/breadcrumbs.js';
import { deferChat } from '../lib/defer-chat.js';
import { categoryCss } from '../lib/category-css.js';
import Header from '../components/Header.astro';
import Offcanvas from '../components/Offcanvas.astro';
import Footer from '../components/Footer.astro';
import JoinChat from '../components/JoinChat.astro';

const { page, headExtra = '' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-US">
<head>
<Fragment set:html={(deferChat(refreshPriceValidUntil(rewrite(page.head))))} />
<Fragment set:html={breadcrumbSchema(page)} />
<Fragment set:html={headExtra} />
<Fragment set:html={cssFixes} />
<Fragment set:html={modernCss} />
<Fragment set:html={categoryCss} />
</head>

<body class={page.bodyClass}>
<Fragment set:html={page.bodyOpen} />

		<div id="main-container" class="site">
			<Fragment set:html={skipLink} />
				<Header page={page} />
				<Offcanvas page={page} />
				<slot />
				<Footer page={page} />
				</div><!-- #page -->
<Fragment set:html={stripDeadScripts(stripEagerRecaptcha(rewrite(page.bodyTail)), page.content)} />
{page.popup && <Fragment set:html={rewrite(page.popup)} />}
<JoinChat page={page} />
<script src="/assets/ttp.js" data-elementor-frontend={page.elementorFrontend ? "1" : "0"} defer></script>
<script src="/assets/cart.js" defer></script>
</body>
</html>
